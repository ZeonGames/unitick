diff --git a/crates/vrf-transform/src/versions/v11_06.rs b/crates/vrf-transform/src/versions/v11_06.rs
new file mode 100644
index 0000000..a83f2a4
--- /dev/null
+++ b/crates/vrf-transform/src/versions/v11_06.rs
@@ -0,0 +1,61 @@
+//! `++Ares-Core+release-11.06`
+//!
+//! The first build that shipped replays. Ported from ValorantReplayParser
+//! (MIT), `ValorantSeededTransform11_06.cs`. Uses the shared S-boxes three
+//! times per word, then a bit reversal and an adjacent-bit swap.
+
+use super::SeededTransform;
+use crate::helpers::{
+    substitute_bytes_u32, substitute_bytes_u64, swap_adjacent_bits_u8, swap_adjacent_bits_u32,
+    swap_adjacent_bits_u64,
+};
+use crate::sbox::{SBOX_8, SBOX_32, SBOX_64};
+
+/// `++Ares-Core+release-11.06`
+pub struct V11_06;
+
+fn reverse_bits64_without_final_16bit_swap(mut v: u64) -> u64 {
+    v = ((v & 0x5555_5555_5555_5555) << 1) | ((v >> 1) & 0x5555_5555_5555_5555);
+    v = ((v & 0x3333_3333_3333_3333) << 2) | ((v >> 2) & 0x3333_3333_3333_3333);
+    v = ((v & 0x0F0F_0F0F_0F0F_0F0F) << 4) | ((v >> 4) & 0x0F0F_0F0F_0F0F_0F0F);
+    v = ((v & 0x00FF_00FF_00FF_00FF) << 8) | ((v >> 8) & 0x00FF_00FF_00FF_00FF);
+    v.rotate_left(32)
+}
+
+impl SeededTransform for V11_06 {
+    const BRANCH: &'static str = "++Ares-Core+release-11.06";
+    const SEED_ADDEND: u32 = 0x3325_e3bd;
+    const INIT_A_OFFSET: u32 = 0x3d;
+    const ADD_OFFSET: bool = true;
+    const TAIL_XOR: u8 = 0xbd;
+
+    fn word64(mut v: u64, state: u32) -> u64 {
+        v = v.wrapping_add(u64::from(state.rotate_right(8)));
+        v = substitute_bytes_u64(v, &SBOX_64);
+        v ^= !u64::from(state.rotate_right(6));
+        v = substitute_bytes_u64(v, &SBOX_64);
+        v = substitute_bytes_u64(v, &SBOX_64);
+        v = reverse_bits64_without_final_16bit_swap(v);
+        swap_adjacent_bits_u64(v)
+    }
+
+    fn word32(mut v: u32, state: u32) -> u32 {
+        v = v.wrapping_add(state.rotate_left(8));
+        v = substitute_bytes_u32(v, &SBOX_32);
+        v ^= state.rotate_left(6);
+        v = substitute_bytes_u32(v, &SBOX_32);
+        v = substitute_bytes_u32(v, &SBOX_32);
+        v = v.reverse_bits();
+        swap_adjacent_bits_u32(v)
+    }
+
+    fn byte(mut v: u8, state: u32) -> u8 {
+        v = v.wrapping_add(state.wrapping_mul(0x0cc6_db61) as u8);
+        v = SBOX_8[v as usize];
+        v ^= state.wrapping_mul(0x001b_0829) as u8;
+        v = SBOX_8[v as usize];
+        v = SBOX_8[v as usize];
+        v = v.reverse_bits();
+        swap_adjacent_bits_u8(v)
+    }
+}
diff --git a/crates/vrf-transform/src/versions/v12_06.rs b/crates/vrf-transform/src/versions/v12_06.rs
new file mode 100644
index 0000000..571d96e
--- /dev/null
+++ b/crates/vrf-transform/src/versions/v12_06.rs
@@ -0,0 +1,58 @@
+//! `++Ares-Core+release-12.06`
+//!
+//! Ported from ValorantReplayParser (MIT), `ValorantSeededTransform12_06.cs`.
+//! Older shape than 12.10+: each word is XORed, rotated, offset, then
+//! bit-reversed around a second rotation, and the init-A offset is added.
+
+use super::SeededTransform;
+
+/// `++Ares-Core+release-12.06`
+pub struct V12_06;
+
+/// Full bit reversal of each 32-bit half, then the halves swapped; the final
+/// 16-bit swap of a true 64-bit reversal is left out (as in the original).
+fn reverse_bits64_without_final_16bit_swap(mut v: u64) -> u64 {
+    v = ((v & 0x5555_5555_5555_5555) << 1) | ((v >> 1) & 0x5555_5555_5555_5555);
+    v = ((v & 0x3333_3333_3333_3333) << 2) | ((v >> 2) & 0x3333_3333_3333_3333);
+    v = ((v & 0x0F0F_0F0F_0F0F_0F0F) << 4) | ((v >> 4) & 0x0F0F_0F0F_0F0F_0F0F);
+    v = ((v & 0x00FF_00FF_00FF_00FF) << 8) | ((v >> 8) & 0x00FF_00FF_00FF_00FF);
+    v.rotate_left(32)
+}
+
+impl SeededTransform for V12_06 {
+    const BRANCH: &'static str = "++Ares-Core+release-12.06";
+    const SEED_ADDEND: u32 = 0x8d68_6ca6;
+    const INIT_A_OFFSET: u32 = 0x26;
+    const ADD_OFFSET: bool = true;
+    const TAIL_XOR: u8 = 0xa6;
+
+    fn word64(mut v: u64, state: u32) -> u64 {
+        v ^= !u64::from(state.rotate_right(8));
+        v = v.rotate_right((state.rotate_right(7) % 63) + 1);
+        v = v.wrapping_sub(u64::from(state.rotate_right(6)));
+        v = reverse_bits64_without_final_16bit_swap(v);
+        v = v.rotate_left((state.rotate_right(3) % 63) + 1);
+        v = reverse_bits64_without_final_16bit_swap(v);
+        v.wrapping_sub(u64::from(state.rotate_right(1)))
+    }
+
+    fn word32(mut v: u32, state: u32) -> u32 {
+        v ^= state.rotate_left(8);
+        v = v.rotate_right((state.rotate_left(7) % 31) + 1);
+        v = v.wrapping_sub(state.rotate_left(6));
+        v = v.reverse_bits();
+        v = v.rotate_left((state.rotate_left(3) % 31) + 1);
+        v = v.reverse_bits();
+        v.wrapping_sub(state.rotate_left(1))
+    }
+
+    fn byte(mut v: u8, state: u32) -> u8 {
+        v ^= state.wrapping_mul(0x0cc6_db61) as u8;
+        v = v.rotate_right((state.wrapping_mul(0x0129_59c3) % 7) + 1);
+        v = v.wrapping_sub(state.wrapping_mul(0x001b_0829) as u8);
+        v = v.reverse_bits();
+        v = v.rotate_left((state.wrapping_mul(0x533) % 7) + 1);
+        v = v.reverse_bits();
+        v.wrapping_sub(state.wrapping_mul(0x0b) as u8)
+    }
+}
diff --git a/crates/vrf-transform/src/versions/v13_04.rs b/crates/vrf-transform/src/versions/v13_04.rs
new file mode 100644
index 0000000..7373a84
--- /dev/null
+++ b/crates/vrf-transform/src/versions/v13_04.rs
@@ -0,0 +1,50 @@
+//! `++Ares-Core+release-13.04`
+//!
+//! Ported from ValorantReplayParser (MIT), `ValorantSeededTransform13_04.cs`.
+
+use super::SeededTransform;
+use crate::helpers::{swap_adjacent_bits_u8, swap_adjacent_bits_u32, swap_adjacent_bits_u64};
+
+/// `++Ares-Core+release-13.04`
+pub struct V13_04;
+
+impl SeededTransform for V13_04 {
+    const BRANCH: &'static str = "++Ares-Core+release-13.04";
+    const SEED_ADDEND: u32 = 0x076d_c658;
+    const INIT_A_OFFSET: u32 = 0x28;
+    const TAIL_XOR: u8 = 0x58;
+
+    fn word64(mut v: u64, state: u32) -> u64 {
+        v = v.rotate_right((state.rotate_right(7) % 63) + 1);
+        v ^= !u64::from(state.rotate_right(6));
+        v = v.wrapping_sub(u64::from(state.rotate_right(5)));
+        v = swap_adjacent_bits_u64(v);
+        v = v.wrapping_add(u64::from(state.rotate_right(3)));
+        v = v.wrapping_add(u64::from(state.rotate_right(2)));
+        v.rotate_left((state.rotate_right(1) % 63) + 1)
+    }
+
+    fn word32(mut v: u32, state: u32) -> u32 {
+        v = v.rotate_right((state.rotate_left(7) % 31) + 1);
+        v ^= state.rotate_left(6);
+        v = v.wrapping_sub(state.rotate_left(5));
+        v = swap_adjacent_bits_u32(v);
+        v = v.wrapping_add(state.rotate_left(3));
+        v = v.wrapping_add(state.rotate_left(2));
+        v.rotate_left((state.rotate_left(1) % 31) + 1)
+    }
+
+    fn byte(mut v: u8, state: u32) -> u8 {
+        let a = state.wrapping_mul(0x0b);
+        let b = a.wrapping_mul(0x0b);
+        let c = b.wrapping_mul(0x0b);
+        let d = c.wrapping_mul(0x79);
+        let e = d.wrapping_mul(0x0b);
+        let f = e.wrapping_mul(0x0b);
+        v = v.rotate_right((f % 7) + 1);
+        v = (v ^ e as u8).wrapping_sub(d as u8);
+        v = swap_adjacent_bits_u8(v);
+        v = v.wrapping_add(b as u8).wrapping_add(c as u8);
+        v.rotate_left((a % 7) + 1)
+    }
+}
